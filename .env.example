# Postgres connection string (Neon). Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# LLM provider: "gemini" for real runs, "mock" for offline demos and tests
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: override the model (default: gemini-flash-latest)
GEMINI_MODEL=
# Optional: comma-separated fallbacks used on 429/503 (default: gemini-flash-lite-latest)
GEMINI_FALLBACK_MODELS=
# Optional: per-call timeout before falling back (default 45000 ms)
GEMINI_TIMEOUT_MS=

# Local API port
PORT=8787
# Log level: debug | info | warn | error
LOG_LEVEL=info
